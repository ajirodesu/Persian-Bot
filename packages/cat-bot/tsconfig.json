{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "esnext",
    "lib": ["esnext"],
    "types": ["node"],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "allowJs": true,
    /* Path Mapping */
    "paths": {
      "@/*": ["./src/*"],
      "@cat-bot/*": ["./src/*"]
    }
  },
  "include": ["src"],
  /* Tests run from src via vitest — they never ship in dist. */
  "exclude": ["src/**/*.test.ts"]
}
