# Optional — defaults to 3000 when unset
PORT=3000

# Valid levels: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info

# ── Bot Management API / Better Auth ───────────────────────────────────────────
BETTER_AUTH_SECRET=generate_with_openssl_rand_base64_32
BETTER_AUTH_URL=http://localhost:3000

# For web development
VITE_URL=http://localhost:5173

# Required. Valid values: mongodb | neondb | turso
DATABASE_TYPE=neondb


# ── Telegram Webhook (optional — recommended for production) ────────────────────
# Set to your bare public domain (no protocol) to enable webhook mode.
# Leave unset to use long-polling (default; works without a public domain, but less scalable).
# TELEGRAM_WEBHOOK_DOMAIN=https://your-domain.com

# ── Credential Encryption ─────────────────────────────────────────────────────
# The Telegram webhook secret token is automatically derived from ENCRYPTION_KEY +
# userId + sessionId — no TELEGRAM_WEBHOOK_SECRET_TOKEN variable is needed.
#
# Required: AES-256-GCM symmetric key for encrypting platform credentials at rest.
# Generate a secure key with: openssl rand -hex 32
ENCRYPTION_KEY=your_64_hex_char_key_here


# ── NeonDB (only used when DATABASE_TYPE=neondb) ──────────────────────────────
# ---------------------------------------------------------------------------
# Neon PostgreSQL connection string.
# Find this in the Neon Console: project → Connection Details → Connection string
#
# Format: postgres://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require
#
# Quick setup:
#   1. Create a project at https://console.neon.tech
#   2. Copy the connection string from Connection Details
#   3. Set DATABASE_TYPE=neondb in this file
#   4. Run the schema: psql $NEON_DATABASE_URL -f packages/database/adapters/neondb/src/schema.sql
#      OR call initDb() at application boot (it runs schema.sql statements automatically)
#   5. Run better-auth schema: cd packages/cat-bot && npx @better-auth/cli migrate
#
# The pool is also used directly by better-auth — no additional ORM needed.
NEON_DATABASE_URL=postgres://username:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── MongoDB (only used when DATABASE_TYPE=mongodb) ────────────────────────────
# ------------------------------------------------------------------------------
# MongoDB connection URI template with <PASSWORD> placeholder
# The <PASSWORD> placeholder will be automatically replaced with MONGO_PASSWORD
#
# Format examples:
# - MongoDB Atlas: mongodb+srv://username:<PASSWORD>@cluster0.mongodb.net?retryWrites=true&w=majority
# - Local MongoDB: mongodb://username:<PASSWORD>@127.0.0.1:27017
# - Docker MongoDB: mongodb://username:<PASSWORD>@mongodb:27017
#
# Note: DO NOT include the database name in the URI - use MONGO_DATABASE_NAME instead
# Note: DO NOT URI-encode the password here - it will be automatically encoded
MONGODB_URI=mongodb+srv://username:<PASSWORD>@cluster0.mongodb.net?retryWrites=true&w=majority

# MongoDB password (will be automatically URI-encoded)
# Can contain special characters like: @ # $ % & etc.
# These will be properly encoded to prevent connection issues
MONGO_PASSWORD=your-mongodb-password

# Database name for MongoDB connections
# This is used by the MongoDB adapter (better-auth + all bot repo collections)
# If not set, will throw an error at startup — always set this when DATABASE_TYPE=mongodb
MONGO_DATABASE_NAME=catbot

# ── Turso (only used when DATABASE_TYPE=turso) ─────────────────────────────────
# ---------------------------------------------------------------------------
# Turso is a managed libSQL (SQLite-compatible) database. Connection details are
# found in the Turso dashboard, or via the CLI: `turso db show <db-name>`.
#
# Format: libsql://<db-name>-<org>.turso.io  (or file:./local.db for a local file)
#
# Quick setup:
#   1. Install the CLI: curl -sSfL https://get.tur.so/install.sh | bash
#   2. Create a database: turso db create cat-bot
#   3. Get the URL: turso db show cat-bot --url
#   4. Create an auth token: turso db tokens create cat-bot
#   5. Set DATABASE_TYPE=turso in this file
#   6. Schema is created automatically at boot via initDb() — no manual migration step needed
#   7. Run better-auth schema: cd packages/cat-bot && npx @better-auth/cli migrate
#
# The client is also used directly by better-auth via a Kysely libSQL dialect — no
# additional ORM needed.
TURSO_DATABASE_URL=libsql://cat-bot-yourorg.turso.io

# Auth token for the Turso database above. Optional for local file: URLs, required
# for a remote libsql:// connection.
TURSO_AUTH_TOKEN=your-turso-auth-token


# ── Brevo Transactional Email / Email Verification (optional) ─────────────────
# When set, Cat-Bot sends a verification link to every new user immediately after
# sign-up. Users must click the link before they can sign in. If either var is
# missing, the bot starts normally but verification emails are silently skipped
# (a warning is logged per sign-up attempt).
#
# Brevo setup:
#   1. Create an account at app.brevo.com and confirm a sender address
#      (app.brevo.com/senders) — emails can only be sent from verified senders.
#   2. Go to app.brevo.com/settings/keys/api → Generate a new API key.
#   3. Set BREVO_SENDER_EMAIL to the verified sender address and BREVO_API_KEY to
#      the API key below.
#
BREVO_SENDER_EMAIL=your-verified-sender@example.com
BREVO_API_KEY=your-brevo-api-key
# Feature Toggles
# If false, email verification is bypassed, and password reset flows are hidden.
# Set to 'true' in production when Brevo variables are correctly configured.
VITE_EMAIL_SERVICES_ENABLE=false


# ── GitHub (Admin File Manager, optional) ─────────────────────────────────────
# The Admin dashboard's File Manager is a GitHub-native repository browser and
# editor: it lists, reads, and commits files DIRECTLY to the repo below via the
# GitHub Contents API. Every create/save/rename/delete is a real commit on the
# repo's default branch — no local disk is involved.
#
# When GITHUB_TOKEN is absent the Admin File Manager is disabled and the panel
# shows a "GitHub not configured" setup hint.
#
# Create a fine-grained PAT here: https://github.com/settings/tokens → Contents:Read+Write
# with access restricted to the repository you deploy from.
GITHUB_TOKEN=
GITHUB_REPO_OWNER=ajirodesu
GITHUB_REPO_NAME=Persian-Bot
# Optional. Kept for backward compatibility with deployments that scoped the old
# per-bot sync to a sub-path; the admin file manager browses the whole repo.
GITHUB_REPO_BASE_PATH=packages/cat-bot


# -----------------------------------------------------------------------------
# AI Agent browser tool (optional)
# -----------------------------------------------------------------------------
# The agent's `browser` tool controls a real Chrome/Chromium/Edge via
# puppeteer-core. No configuration is required: it auto-detects a browser
# installed on the host (Windows/macOS/Linux). Use PUPPETEER_EXEC_PATH only to
# point at a specific binary when auto-detection doesn't find one (e.g. a
# portable Chrome not in a standard install location).
#
# Examples:
#   Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
#   macOS:   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Linux:   /usr/bin/google-chrome
PUPPETEER_EXEC_PATH=
# Run the browser headless (no visible window). Set to "false" to open a visible
# window while debugging. Defaults to "true" when unset.
AGENT_BROWSER_HEADLESS=true
